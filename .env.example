# Chairman Agent OS - Environment Configuration
# Copy this to .env and fill in your values

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Port to run server on (default: 8080)
PORT=8080

# Environment: production or development (default: development)
NODE_ENV=development

# Set to 1 for production deployments
PRODUCTION=0

# ============================================================================
# STORAGE - Choose ONE: local or github
# ============================================================================

# Storage mode: local (filesystem) or github (GitHub repo)
STORE=local

# For GitHub storage - get a fine-grained PAT from https://github.com/settings/tokens
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub repo for state storage (format: username/reponame)
# Make sure this repo is PRIVATE!
GH_REPO=youruser/chairman-state

# Optional: specify a branch (default: main)
GH_BRANCH=main

# ============================================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================================

# SMTP Host (e.g., smtp.gmail.com for Gmail)
SMTP_HOST=smtp.gmail.com

# SMTP Port (usually 587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP Username (your email address)
SMTP_USER=your.email@gmail.com

# SMTP Password (Gmail: use 16-char app password from myaccount.google.com/apppasswords)
SMTP_PASS=xxxxxxxxxxxxxxxx

# From address (usually same as SMTP_USER)
SMTP_FROM=your.email@gmail.com

# ============================================================================
# INTEGRATIONS - Notifications
# ============================================================================

# Slack Incoming Webhook URL (for alerts)
# Get from: your-workspace.slack.com/apps/manage/custom-integrations/incoming-webhooks
SLACK_WEBHOOK=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# Discord Webhook URL (for alerts)
# Get from: Discord Server → Channel Settings → Webhooks → Create Webhook
DISCORD_WEBHOOK=https://discordapp.com/api/webhooks/000000000/XXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================================================
# DATABASE (Optional - for future use)
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://user:password@localhost:5432/database
DATABASE_URL=postgresql://chairman:chairman123@localhost:5432/chairman

# ============================================================================
# ADVANCED
# ============================================================================

# Enable debug logging
DEBUG=0

# Maximum body size for API requests (bytes)
MAX_BODY_SIZE=1000000

# Session TTL (time to live) in milliseconds
SESSION_TTL=2592000000

# Max monitors per user
MAX_MONITORS=1000

# Max agents per user
MAX_AGENTS=100
