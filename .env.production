# Karan Dashboard - Production Configuration
# Use these environment variables when deploying to Render, Railway, AWS, etc.

# Server
PORT=8000
NODE_ENV=production
PRODUCTION=1

# Storage (GitHub - required for cloud)
# Create a private GitHub repo named "karan-state"
# Generate a personal access token with "repo" scope
# Set these in your deployment platform's environment variables
STORE=github
GH_TOKEN=your_github_token_here
GH_REPO=your-github-username/karan-state
GH_BRANCH=main

# Service URLs (update to your cloud URLs once deployed)
KARAN_API=http://karan:9000
CHAIRMAN_API=http://chairman:8080
JARVIS_API=http://jarvis:8001

# Optional: Notifications
# SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# DISCORD_WEBHOOK=https://discordapp.com/api/webhooks/YOUR/WEBHOOK

# Optional: Email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password
